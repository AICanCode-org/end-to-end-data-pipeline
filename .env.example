# Copy to .env and edit. Every variable is optional; the defaults run fully offline.
# --- ports (127.0.0.1 only)
SOURCE_PORT=18140
DASHBOARD_PORT=18142
AIRFLOW_PORT=18144
# --- image builds
DEBIAN_MIRROR=https://deb.debian.org   # any HTTPS Debian mirror, e.g. https://cloudfront.debian.net if apt hangs
# --- source stub
SOURCE_VERSION=1.0          # which data the source image generates (1.0: Jun-Aug 2026)
SOURCE_NOW=                 # empty = final state; follow = late updates appear in later windows
SOURCE_FAULT_RATE=0         # e.g. 0.2: 20% of API calls answer 429/503 (retries must cope)
SOURCE_API_TOKEN=bazaarbox-dev-token
# --- pipeline (when running outside Docker)
PIPEWRIGHT_TRACK=sql        # sql | pyspark
PIPEWRIGHT_LAKE_DIR=lake
PIPEWRIGHT_WAREHOUSE=warehouse/pipewright.duckdb
PIPEWRIGHT_DROPS_DIR=source-data/drops
SOURCE_API_URL=http://127.0.0.1:18140
PIPEWRIGHT_PAGE_SIZE=200
PIPEWRIGHT_HTTP_TIMEOUT=10
PIPEWRIGHT_MAX_ATTEMPTS=5
DASHBOARD_TRACK=sql         # which track's warehouse the dashboard shows
# --- optional AI incident explainer (any OpenAI-compatible endpoint; nothing is sent unless AI_PROVIDER=openai)
AI_PROVIDER=template        # template | openai
AI_BASE_URL=                # e.g. http://host.docker.internal:11434/v1 (Ollama) - only aggregate check facts are sent
AI_MODEL=                   # e.g. llama3.2
AI_API_KEY=                 # leave empty for local models; never commit a real key
AI_TIMEOUT=15
# --- Airflow metadata DB (local only)
AIRFLOW_DB_PASSWORD=airflow-local-only
